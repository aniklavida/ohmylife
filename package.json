{
  "name": "ohmylife",
  "version": "0.0.0",
  "private": true,
  "description": "A self-hosted life, kept by whichever AI you already run.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:sample": "OHMYLIFE_LIFE=examples/sample-life OHMYLIFE_DB=.ohmylife/dev-index.db next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "rebuild-index": "tsx scripts/rebuild-index.ts",
    "mcp": "tsx mcp/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "gray-matter": "^4.0.3",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  }
}
